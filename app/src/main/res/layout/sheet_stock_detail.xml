<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Header: symbol, price and 5D change, then tier and score. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detailExchange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/detail_exchange"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detailPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/detailTier"
            style="@style/Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:minWidth="64dp"
            android:textSize="10sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/detailScoreBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:max="1000"
            app:trackColor="@color/track"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/detailScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- The stock's facts or its news, one at a time (StockDetailSheet.showTab). -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/detailTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/brand_primary"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabTextColor="@color/text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_tab_overview" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_tab_news" />
    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- The जानकारी tab: chart, plan, score, R/S and the key numbers. -->
            <LinearLayout
                android:id="@+id/detailOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- What the company makes (ProductBook): a tile per product with its picture and name, filled in code; a tap
                     filters the list. -->
                <LinearLayout
                    android:id="@+id/detailProductsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- The heading, after the company's logo once it comes in (ProductPhotos). -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <ImageView
                            android:id="@+id/detailProductsLogo"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_product_logo"
                            android:importantForAccessibility="no"
                            android:padding="3dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_section_products"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detailProductsHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/detail_products_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- The share picture of the company's own website, once it comes in. -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/detailProductsBanner"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="10dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearance="@style/ShapeAppearance.ShareScan.Photo" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/detailProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="20dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />

                    <TextView
                        android:id="@+id/detailProductsCredit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/detail_products_credit"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Shown instead of the chart, plan and technical stats when the scan had no price structure. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/detailNoStructure"
                    style="@style/ShareScanCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/neutral_container"
                    app:strokeWidth="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/detail_no_structure"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Chart -->
                <LinearLayout
                    android:id="@+id/detailChartSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_section_chart"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/detailChartPeriod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFeatureSettings="tnum"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/detailChartCard"
                        style="@style/ShareScanCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <com.rohit.share_scan.PriceChartView
                            android:id="@+id/detailChart"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:importantForAccessibility="yes"
                            android:paddingStart="12dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="12dp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Opens the trade window (TradeWindow): the chart large, the targets by horizon and the trade plan; the
                     chart card opens it too. Shown even without a chart, for the intraday and long-term targets. -->
                <TextView
                    android:id="@+id/detailOpenTrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_icon_tile"
                    android:backgroundTint="@color/primary_container"
                    android:drawablePadding="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="@string/detail_open_trade"
                    android:textColor="@color/on_primary_container"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_trending_up"
                    app:drawableTint="@color/on_primary_container" />

                <!-- Score breakdown -->
                <LinearLayout
                    android:id="@+id/detailScoreSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/detail_section_score"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/detail_score_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/ShareScanCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:id="@+id/detailScoreParts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="6dp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 360CR (Cr360Book): the company's research score from the daily file, its parts and the figures behind it. -->
                <LinearLayout
                    android:id="@+id/detailCr360Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/detail_section_cr360"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/detail_cr360_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/ShareScanCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp">

                                <TextView
                                    android:id="@+id/detailCr360Score"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="@color/text_primary"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/detailCr360State"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/detailCr360Data"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <!-- The valuation framework: value, buy price, flags (Cr360FrameworkCard); its full calculation
                                 opens from the line after it. -->
                            <LinearLayout
                                android:id="@+id/detailCr360Framework"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical"
                                android:paddingHorizontal="16dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/detailCr360FrameworkOpen"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:text="@string/fw_open"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/detailCr360FrameworkBody"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingHorizontal="16dp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/detailCr360Parts"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="vertical" />

                            <!-- The figures behind the score, a line each (StockDetailSheet.cr360Facts); the insider and deals
                                 lines open into every trade behind them. -->
                            <LinearLayout
                                android:id="@+id/detailCr360Facts"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="vertical"
                                android:paddingHorizontal="16dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/detailCr360Note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/detail_cr360_note"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <!-- The long-term checklist (Moat) from the R/S figures; its lines open and close on the title. -->
                    <TextView
                        android:id="@+id/detailMoatTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/moat_title"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailMoatSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:paddingHorizontal="20dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/detailMoat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp" />

                    <!-- R/S history (Cr360History): fetched when the sheet opens, its tables filled in code. -->
                    <LinearLayout
                        android:id="@+id/detailCr360HistorySection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detailCr360HistoryTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:paddingHorizontal="20dp"
                            android:text="@string/detail_section_cr360_history"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/detailCr360HistoryStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:paddingHorizontal="20dp"
                            android:text="@string/detail_cr360_history_loading"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/detailCr360History"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Key stats: rows of two tiles, filled in code. -->
                <LinearLayout
                    android:id="@+id/detailStatsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detailStatsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/detail_section_stats"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/detailStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- The खबरें tab (NewsRepository): the exchange's filings and newspapers' articles, filled in code. -->
            <LinearLayout
                android:id="@+id/detailNewsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/detailNewsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/news_loading"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/detailNews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/detail_disclaimer"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- The stock in a trading app (BrokerOpener): Groww's page for it, or Angel One's and Zerodha's search. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailOpenGroww"
            style="@style/Widget.ShareScan.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="@string/broker_groww"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="@dimen/broker_icon"
            app:iconTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailOpenAngelOne"
            style="@style/Widget.ShareScan.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="@string/broker_angel_one"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="@dimen/broker_icon"
            app:iconTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detailOpenZerodha"
            style="@style/Widget.ShareScan.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="@string/broker_zerodha"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="@dimen/broker_icon"
            app:iconTint="@null" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/detailOpenChart"
        android:stateListAnimator="@animator/press_scale_soft"
        android:layout_width="match_parent"
