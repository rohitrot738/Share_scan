<?xml version="1.0" encoding="utf-8"?>
<!-- The menu's Account sheet (AccountSheet.kt): one of the three blocks below shows, by login state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/sheetTopBar"
        layout="@layout/sheet_top_bar" />

    <TextView
        style="@style/SheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/account_title" />

    <TextView
        android:id="@+id/accountSubtitle"
        style="@style/SheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/accountProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:contentDescription="@string/account_working"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="2dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- This build has no Firebase config yet. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accountUnconfigured"
                style="@style/ShareScanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="@color/brand_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_unconfigured_title" />

                        <TextView
                            style="@style/SettingsRowBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/account_unconfigured_body" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Signed out: Google, GitHub, or email + password. -->
            <LinearLayout
                android:id="@+id/accountSignedOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountGoogle"
                    style="@style/Widget.ShareScan.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/account_google"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="textStart"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountGithub"
                    style="@style/Widget.ShareScan.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/account_github"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_github"
                    app:iconGravity="textStart" />

                <TextView
                    style="@style/SettingsRowBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_horizontal"
                    android:text="@string/account_or_email" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/ShareScanCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/accountEmailLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/account_email_hint"
                            app:startIconDrawable="@drawable/ic_mail">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/accountEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="emailAddress"
                                android:imeOptions="actionNext"
                                android:inputType="textEmailAddress"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/accountPasswordLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/account_password_hint"
                            app:endIconMode="password_toggle"
                            app:startIconDrawable="@drawable/ic_lock">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/accountPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="password"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/accountSignIn"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="14dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/account_sign_in"
                            android:textAllCaps="false"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/accountCreate"
                            style="@style/Widget.ShareScan.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/account_create"
                            android:textAllCaps="false"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/accountForgot"
                            style="@style/Widget.ShareScan.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp"
                            android:text="@string/account_forgot"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Signed in: profile, details and account actions. -->
            <LinearLayout
                android:id="@+id/accountSignedIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/ShareScanCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <TextView
                                android:id="@+id/accountInitial"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/primary_container"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:textColor="@color/on_primary_container"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <!-- Clipped to the circle in code (clipToOutline) once the photo arrives. -->
                            <ImageView
                                android:id="@+id/accountPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/accountName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/accountEmailText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/accountVerified"
                                style="@style/Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/accountPhone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SettingsSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account_section_details" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/ShareScanCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="8dp">

                        <TextView
                            style="@style/SettingsRowBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:text="@string/account_methods" />

                        <TextView
                            android:id="@+id/accountMethods"
                            style="@style/SettingsRowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingBottom="8dp" />

                        <TextView
                            style="@style/SettingsRowBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:text="@string/account_created_at" />

                        <TextView
                            android:id="@+id/accountCreatedAt"
                            style="@style/SettingsRowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:paddingHorizontal="16dp"
                            android:paddingBottom="8dp" />

                        <TextView
                            style="@style/SettingsRowBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:text="@string/account_last_sign_in" />

                        <TextView
                            android:id="@+id/accountLastSignIn"
                            style="@style/SettingsRowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:paddingHorizontal="16dp"
                            android:paddingBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="4dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/SettingsRowBody"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/account_uid" />

                                <TextView
                                    android:id="@+id/accountUid"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="monospace"
                                    android:textColor="@color/text_primary"
                                    android:textIsSelectable="true"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/accountCopyUid"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/account_copy_uid"
                                android:padding="12dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_copy"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SettingsSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account_section_actions" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountEditName"
                    style="@style/SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_edit_name"
                    app:icon="@drawable/ic_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountSendVerification"
                    style="@style/SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_send_verification"
                    app:icon="@drawable/ic_mail" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountChangePassword"
                    style="@style/SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_change_password"
                    app:icon="@drawable/ic_lock" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountLinkGoogle"
                    style="@style/SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_link_google"
                    app:icon="@drawable/ic_google"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountLinkGithub"
                    style="@style/SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_link_github"
                    app:icon="@drawable/ic_github" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountSignOut"
                    style="@style/Widget.ShareScan.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/account_sign_out"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountDelete"
                    style="@style/Widget.ShareScan.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/account_delete"
                    android:textAllCaps="false"
                    android:textColor="@color/bear"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/bear" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
