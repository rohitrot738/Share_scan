<?xml version="1.0" encoding="utf-8"?>
<!-- Top of every menu sheet: the drag handle, ← back to the menu (sheets opened from it) and ✕ close. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ImageButton
        android:id="@+id/sheetBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sheet_back"
        android:src="@drawable/ic_arrow_back"
        android:visibility="gone"
        app:tint="@color/text_primary" />

    <ImageButton
        android:id="@+id/sheetClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sheet_close"
        android:src="@drawable/ic_close"
        app:tint="@color/text_secondary" />
</FrameLayout>
