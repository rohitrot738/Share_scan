<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/sheetTopBar"
        layout="@layout/sheet_top_bar" />

    <!-- The background picker (BackgroundSheet) shares this sheet and sets its own title. -->
    <TextView
        android:id="@+id/themeTitle"
        style="@style/SheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_title" />

    <TextView
        android:id="@+id/themeSubtitle"
        style="@style/SheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_subtitle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/themeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
