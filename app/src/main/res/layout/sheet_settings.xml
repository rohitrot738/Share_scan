<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/sheetTopBar"
        layout="@layout/sheet_top_bar" />

    <TextView
        style="@style/SheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title" />

    <TextView
        style="@style/SheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_subtitle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                style="@style/SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_live" />

            <!-- Live mode: scans through market hours in the background, every interval picked below. -->
            <LinearLayout
                android:id="@+id/settingLiveRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_live" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_live_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_live" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/settingLiveInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <LinearLayout
                android:id="@+id/settingLiveAlertsRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_live_alerts" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_live_alerts_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingLiveAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_live_alerts" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingWatchAlertsRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_watch_alerts" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_watch_alerts_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingWatchAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_watch_alerts" />
            </LinearLayout>

            <!-- Shown while Android blocks the app's notifications; tapping it opens their system settings. -->
            <TextView
                android:id="@+id/settingNotifyBlocked"
                style="@style/SettingsRowBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="@string/settings_notify_blocked"
                android:textColor="@color/warn"
                android:visibility="gone" />

            <TextView
                style="@style/SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_app" />

            <LinearLayout
                android:id="@+id/settingUpdatesRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_updates" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_updates_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingUpdates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_updates" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingScreenRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_screen" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_screen_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingScreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_screen" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingSkyRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_sky" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_sky_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingSky"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_sky" />
            </LinearLayout>

            <!-- Glass mode: picking one re-creates the screen in it, so the line under the chips describes the current one. -->
            <TextView
                style="@style/SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_glass" />

            <!-- Glass on at all: off re-creates the screen flat and solid and greys out the modes below. -->
            <LinearLayout
                android:id="@+id/settingGlassRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_glass_on" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_glass_on_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingGlassOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_glass_on" />
            </LinearLayout>

            <TextView
                style="@style/SettingsRowBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="@string/settings_glass_body" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/settingGlass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="20dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/settingGlassCurrent"
                style="@style/SettingsRowBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp" />

            <TextView
                style="@style/SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_scan" />

            <LinearLayout
                android:id="@+id/settingNseRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_nse" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_nse_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingNse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_nse" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingSmeRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_sme" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_sme_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingSme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_sme" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingBseRow"
                style="@style/SettingsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bse" />

                    <TextView
                        style="@style/SettingsRowBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bse_body" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settingBse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_bse" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_chart" />

            <TextView
                style="@style/SettingsRowBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="@string/settings_chart_body" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/settingChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="20dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                style="@style/SettingsSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_data" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingClearWatchlist"
                style="@style/SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_star_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingResetFilters"
                style="@style/SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_reset_filters"
                app:icon="@drawable/ic_tune" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingClearRanks"
                style="@style/SettingsAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_clear_ranks"
                app:icon="@drawable/ic_delete" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
