<?xml version="1.0" encoding="utf-8"?>
<!-- Glass chip edge: a light rim, the accent when checked, nearly gone when disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.08" android:color="@android:color/white" android:state_enabled="false" />
    <item android:color="?attr/colorPrimary" android:state_checked="true" />
    <item android:color="?attr/colorPrimary" android:state_activated="true" />
    <item android:alpha="0.42" android:color="@android:color/white" />
</selector>
