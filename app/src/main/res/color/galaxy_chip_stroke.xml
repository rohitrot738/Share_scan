<?xml version="1.0" encoding="utf-8"?>
<!-- Chip outline: soft violet, full violet when checked, faint when disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.16" android:color="@color/galaxy_violet" android:state_enabled="false" />
    <item android:color="@color/galaxy_violet" android:state_checked="true" />
    <item android:alpha="0.45" android:color="@color/galaxy_violet" />
</selector>
