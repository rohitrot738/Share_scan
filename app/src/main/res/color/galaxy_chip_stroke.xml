<?xml version="1.0" encoding="utf-8"?>
<!-- Chip outline: soft accent, full accent when checked, faint when disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.16" android:color="?attr/colorPrimary" android:state_enabled="false" />
    <item android:color="?attr/colorPrimary" android:state_checked="true" />
    <item android:alpha="0.45" android:color="?attr/colorPrimary" />
</selector>
