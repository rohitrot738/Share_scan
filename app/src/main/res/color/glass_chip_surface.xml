<?xml version="1.0" encoding="utf-8"?>
<!--
    Glass chip base (chipSurfaceColor): smoked, see-through glass that gives the tint below it depth; how smoked
    follows the glass mode (opaque in Solid).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/glassChipSurfaceOn" android:state_enabled="false" />
    <item android:color="?attr/glassChipSurfaceOn" android:state_checked="true" />
    <item android:color="?attr/glassChipSurfaceOn" android:state_activated="true" />
    <item android:color="?attr/glassChipSurface" />
</selector>
