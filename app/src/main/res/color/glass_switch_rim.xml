    <item android:alpha="0.10" android:color="@android:color/white" android:state_enabled="false" />
    <item android:alpha="0.50" android:color="@android:color/white" android:state_checked="true" />
    <item android:alpha="0.42" android:color="@android:color/white" />
</selector>
