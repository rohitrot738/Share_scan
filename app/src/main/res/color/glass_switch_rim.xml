<?xml version="1.0" encoding="utf-8"?>
<!-- Glass switch rim: a thin light edge around the track in both states. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.10" android:color="@android:color/white" android:state_enabled="false" />
    <item android:alpha="0.70" android:color="@android:color/white" android:state_checked="true" />
    <item android:alpha="0.55" android:color="@android:color/white" />
</selector>
