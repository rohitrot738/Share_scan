<?xml version="1.0" encoding="utf-8"?>
<!--
    Window background: near-black space gradient, four faint nebula tints and a layered starfield.
    The top stays plain @color/bg so it meets the opaque status-bar strip without a seam; every
    glow fades out before the top 24dp, in portrait and in landscape.
    Glows are sized layers (not full-screen) to keep overdraw low; nothing here animates.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:dither="true" android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/galaxy_space_mid"
                android:endColor="@color/galaxy_space_bottom"
                android:startColor="@color/bg"
                android:type="linear" />
        </shape>
    </item>

    <!-- Violet nebula behind the hero and stats, upper right. -->
    <item
        android:width="480dp"
        android:height="480dp"
        android:end="-200dp"
        android:gravity="top|end"
        android:top="90dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#068B5CF6"
                android:endColor="#008B5CF6"
                android:gradientRadius="50%"
                android:startColor="#128B5CF6"
                android:type="radial" />
        </shape>
    </item>

    <!-- Indigo haze, middle left. -->
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|start"
        android:start="-130dp"
        android:top="300dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#064F46E5"
                android:endColor="#004F46E5"
                android:gradientRadius="50%"
                android:startColor="#124F46E5"
                android:type="radial" />
        </shape>
    </item>

    <!-- Magenta nebula, lower left. -->
    <item
        android:width="420dp"
        android:height="420dp"
        android:bottom="-40dp"
        android:gravity="bottom|start"
        android:start="-190dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#06DB2777"
                android:endColor="#00DB2777"
                android:gradientRadius="50%"
                android:startColor="#12DB2777"
                android:type="radial" />
        </shape>
    </item>

    <!-- Cyan haze, bottom right. -->
    <item
        android:width="380dp"
        android:height="380dp"
        android:bottom="-150dp"
        android:end="-110dp"
        android:gravity="bottom|end">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#050891B2"
                android:endColor="#000891B2"
                android:gradientRadius="50%"
                android:startColor="#100891B2"
                android:type="radial" />
        </shape>
    </item>

    <item android:drawable="@drawable/galaxy_stars" />
</layer-list>
