<?xml version="1.0" encoding="utf-8"?>
<!--
    Magnifier scanning a rising chart, in neon over the galaxy background, kept inside the 66dp
    adaptive-icon safe zone. Every stroke is fully opaque so the themed (monochrome) icon,
    which only uses alpha, stays a clean silhouette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M32,49a17,17 0,1 0,34 0a17,17 0,1 0,-34 0z"
        android:strokeWidth="6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="66"
                android:endY="32"
                android:startX="32"
                android:startY="66"
                android:type="linear">
                <item android:color="#FFC4B5FD" android:offset="0" />
                <item android:color="#FFE0F2FE" android:offset="0.5" />
                <item android:color="#FF67E8F9" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#00000000"
        android:pathData="M62,62L74,74"
        android:strokeLineCap="round"
        android:strokeWidth="8">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="74"
                android:endY="74"
                android:startX="62"
                android:startY="62"
                android:type="linear">
                <item android:color="#FFC084FC" android:offset="0" />
                <item android:color="#FFF472B6" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#00000000"
        android:pathData="M39.5,55L45,49.5L50,53.5L57.5,45"
        android:strokeWidth="3.5"
        android:strokeColor="@color/icon_mint"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
