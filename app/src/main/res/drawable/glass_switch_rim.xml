<?xml version="1.0" encoding="utf-8"?>
<!--
    Switch track decoration, tinted (SRC_IN) by color/glass_switch_rim: a sheen that fades down from the top edge,
    like light on glass, under a thin rim. Same size and shape as Material's own track.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:centerColor="#1AFFFFFF"
                android:centerY="0.45"
                android:endColor="#00FFFFFF"
                android:startColor="#66FFFFFF"
                android:type="linear" />
            <size
                android:width="52dp"
                android:height="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FFFFFFFF" />
            <size
                android:width="52dp"
                android:height="32dp" />
        </shape>
    </item>
</layer-list>
