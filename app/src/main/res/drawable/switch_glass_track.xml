<?xml version="1.0" encoding="utf-8"?>
<!-- Glass switch track; replaces Material's flat tinted track (the style sets trackTint to @null). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:drawable="@drawable/switch_glass_track_on" android:state_checked="true" />
    <item android:drawable="@drawable/switch_glass_track_off" />
</selector>
