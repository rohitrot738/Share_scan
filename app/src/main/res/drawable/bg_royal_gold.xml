<?xml version="1.0" encoding="utf-8"?>
<!-- Window background for the Royal Gold theme: bg_galaxy.xml with this theme's sky and nebula tints. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:dither="true" android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/royal_gold_space_mid"
                android:endColor="@color/royal_gold_space_bottom"
                android:startColor="@color/royal_gold_bg"
                android:type="linear" />
        </shape>
    </item>

    <!-- Gold glow behind the hero and stats, upper right. -->
    <item
        android:width="480dp"
        android:height="480dp"
        android:end="-200dp"
        android:gravity="top|end"
        android:top="90dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#06EAB308"
                android:endColor="#00EAB308"
                android:gradientRadius="50%"
                android:startColor="#12EAB308"
                android:type="radial" />
        </shape>
    </item>

    <!-- Violet haze, middle left. -->
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|start"
        android:start="-130dp"
        android:top="300dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#067C3AED"
                android:endColor="#007C3AED"
                android:gradientRadius="50%"
                android:startColor="#127C3AED"
                android:type="radial" />
        </shape>
    </item>

    <!-- Purple glow, lower left. -->
    <item
        android:width="420dp"
        android:height="420dp"
        android:bottom="-40dp"
        android:gravity="bottom|start"
        android:start="-190dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#06A855F7"
                android:endColor="#00A855F7"
                android:gradientRadius="50%"
                android:startColor="#12A855F7"
                android:type="radial" />
        </shape>
    </item>

    <!-- Amber haze, bottom right. -->
    <item
        android:width="380dp"
        android:height="380dp"
        android:bottom="-150dp"
        android:end="-110dp"
        android:gravity="bottom|end">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#05F59E0B"
                android:endColor="#00F59E0B"
                android:gradientRadius="50%"
                android:startColor="#10F59E0B"
                android:type="radial" />
        </shape>
    </item>

    <item android:drawable="@drawable/galaxy_stars" />
</layer-list>
