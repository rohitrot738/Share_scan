<?xml version="1.0" encoding="utf-8"?>
<!-- Window background for the Emerald theme: bg_galaxy.xml with this theme's sky and nebula tints. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:dither="true" android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/emerald_space_mid"
                android:endColor="@color/emerald_space_bottom"
                android:startColor="@color/emerald_bg"
                android:type="linear" />
        </shape>
    </item>

    <!-- Emerald glow behind the hero and stats, upper right. -->
    <item
        android:width="480dp"
        android:height="480dp"
        android:end="-200dp"
        android:gravity="top|end"
        android:top="90dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#0610B981"
                android:endColor="#0010B981"
                android:gradientRadius="50%"
                android:startColor="#1210B981"
                android:type="radial" />
        </shape>
    </item>

    <!-- Jade haze, middle left. -->
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|start"
        android:start="-130dp"
        android:top="300dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#06059669"
                android:endColor="#00059669"
                android:gradientRadius="50%"
                android:startColor="#12059669"
                android:type="radial" />
        </shape>
    </item>

    <!-- Teal glow, lower left. -->
    <item
        android:width="420dp"
        android:height="420dp"
        android:bottom="-40dp"
        android:gravity="bottom|start"
        android:start="-190dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#060D9488"
                android:endColor="#000D9488"
                android:gradientRadius="50%"
                android:startColor="#120D9488"
                android:type="radial" />
        </shape>
    </item>

    <!-- Lime haze, bottom right. -->
    <item
        android:width="380dp"
        android:height="380dp"
        android:bottom="-150dp"
        android:end="-110dp"
        android:gravity="bottom|end">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#0584CC16"
                android:endColor="#0084CC16"
                android:gradientRadius="50%"
                android:startColor="#1084CC16"
                android:type="radial" />
        </shape>
    </item>

    <item android:drawable="@drawable/galaxy_stars" />
</layer-list>
