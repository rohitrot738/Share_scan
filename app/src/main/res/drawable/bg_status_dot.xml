<?xml version="1.0" encoding="utf-8"?>
<!--
    The status pill's dot with its glow: a soft halo round a solid core. White, for MainActivity.renderPill to tint
    (green, amber, red...); the tint keeps each layer's alpha.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#47FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
