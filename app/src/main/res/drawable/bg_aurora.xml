<?xml version="1.0" encoding="utf-8"?>
<!-- Window background for the Aurora theme: bg_galaxy.xml with this theme's sky and nebula tints. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:dither="true" android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/aurora_space_mid"
                android:endColor="@color/aurora_space_bottom"
                android:startColor="@color/aurora_bg"
                android:type="linear" />
        </shape>
    </item>

    <!-- Teal aurora behind the hero and stats, upper right. -->
    <item
        android:width="480dp"
        android:height="480dp"
        android:end="-200dp"
        android:gravity="top|end"
        android:top="90dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#062DD4BF"
                android:endColor="#002DD4BF"
                android:gradientRadius="50%"
                android:startColor="#122DD4BF"
                android:type="radial" />
        </shape>
    </item>

    <!-- Green haze, middle left. -->
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="top|start"
        android:start="-130dp"
        android:top="300dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#0622C55E"
                android:endColor="#0022C55E"
                android:gradientRadius="50%"
                android:startColor="#1222C55E"
                android:type="radial" />
        </shape>
    </item>

    <!-- Blue aurora, lower left. -->
    <item
        android:width="420dp"
        android:height="420dp"
        android:bottom="-40dp"
        android:gravity="bottom|start"
        android:start="-190dp">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#063B82F6"
                android:endColor="#003B82F6"
                android:gradientRadius="50%"
                android:startColor="#123B82F6"
                android:type="radial" />
        </shape>
    </item>

    <!-- Teal haze, bottom right. -->
    <item
        android:width="380dp"
        android:height="380dp"
        android:bottom="-150dp"
        android:end="-110dp"
        android:gravity="bottom|end">
        <shape android:dither="true" android:shape="oval">
            <gradient
                android:centerColor="#0514B8A6"
                android:endColor="#0014B8A6"
                android:gradientRadius="50%"
                android:startColor="#1014B8A6"
                android:type="radial" />
        </shape>
    </item>

    <item android:drawable="@drawable/galaxy_stars" />
</layer-list>
