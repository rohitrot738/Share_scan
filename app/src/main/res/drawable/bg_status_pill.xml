<?xml version="1.0" encoding="utf-8"?>
<!-- The compact header's scan status pill: a green glass capsule with a ripple. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3310B981">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/compact_pill_fill" />
            <stroke android:width="1dp" android:color="@color/compact_pill_rim" />
        </shape>
    </item>
</ripple>
