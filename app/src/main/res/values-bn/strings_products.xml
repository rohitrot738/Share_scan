    <string name="detail_section_products">কী তৈরি করে</string>
    <string name="detail_products_hint">কোনো পণ্যে টিপুন: সেটি তৈরি করে এমন কোম্পানিগুলো তালিকায় দেখা যাবে</string>
    <string name="product_chip_description">%1$s তৈরি করে এমন কোম্পানি দেখান</string>
    <string name="product_applied">%1$s তৈরি করে এমন কোম্পানি</string>
    <string name="product_filter_leave">পণ্যের ফিল্টার সরান</string>
    <string name="product_empty_title">এই পণ্যের কোনো কোম্পানি নেই</string>
    <string name="product_empty_body">ফিল্টারের মধ্যে %1$s তৈরি করে এমন কোনো কোম্পানি এই স্ক্যানে পাওয়া যায়নি। উপরের ✕ টিপে পণ্যের ফিল্টার সরান। পণ্যের ডেটা প্রতি রাতে R/S-এর সাথে একটু একটু করে ভরে।</string>
    <string name="settings_product_icons">কার্ডে পণ্যের আইকন</string>
    <string name="help_products_title">🛞 কী তৈরি করে (পণ্য)</string>
    <string name="help_products_body">শেয়ারের বিস্তারিততে \"কী তৈরি করে\"-এর নিচে কোম্পানির পণ্যগুলো তাদের আইকনসহ দেখা যায় — যেমন 🛞 টায়ার, 🚗 গাড়ি, 💊 ওষুধ। এগুলো Screener-এ কোম্পানির About আর Key Points থেকে প্রতি রাতে R/S-এর সাথে পড়া হয় (যে শব্দ শুধু ক্রেতার নাম জানায়, যেমন \"গাড়ির জন্য টায়ার\"-এ গাড়ি, সেগুলো গোনা হয় না)। কোনো পণ্যে টিপলে তালিকায় সেটি তৈরি করে এমন সব কোম্পানি দেখা যায় (ফিল্টারের মধ্যে, Top সীমার বাইরেও); উপরের ✕ বা Back দিয়ে সব ফিরে আসে। মেনু → সেটিংস → \"কার্ডে পণ্যের আইকন\" দিয়ে প্রতিটি কার্ডে নামের আগে মূল 3টি পণ্যের আইকন দেখা যায়। নতুন ডেটা কয়েক দিনের মধ্যে সব শেয়ারের জন্য ভরবে।</string>
    <string name="settings_product_icons_hint">কোম্পানির নামের আগে তার মূল পণ্যের আইকন, যেমন 🛞 🚗</string>
