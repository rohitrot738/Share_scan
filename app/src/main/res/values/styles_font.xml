    </style>
    <style name="TextAppearance.ShareScan.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">?attr/appFont</item>
        <item name="fontFamily">?attr/appFont</item>
    </style>
</resources>
