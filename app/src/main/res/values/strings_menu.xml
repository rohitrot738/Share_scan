    <!-- Score guide -->
    <string name="help_title">Score कैसे बनता है</string>
    <string name="help_subtitle">हर stock को 0–100 का pre-breakout score</string>
    <string name="help_part_breakout">Breakout setup • 35%</string>
    <string name="help_part_breakout_body">Price 20 दिन के high के कितना पास है, पिछले 10 sessions का base कितना tight और शांत है, और close base में कहाँ है। दूरी stock की अपनी औसत daily range (ATR) में नापी जाती है, इसलिए छोटे और बड़े stocks बराबर तौले जाते हैं।</string>
    <string name="help_part_trend">Trend • 20%</string>
    <string name="help_part_trend_body">Price बढ़ते 20 और 50 दिन के औसत (DMA) के ऊपर हो, और 20 DMA, 50 DMA के ऊपर।</string>
    <string name="help_part_volume">Volume • 20%</string>
    <string name="help_part_volume_body">आज का relative volume (RVOL) और उससे पहले के 5 sessions में volume कितना सूखा था — पहले शांति, फिर तेज़ी।</string>
    <string name="help_part_liquidity">Liquidity • 15%</string>
    <string name="help_part_liquidity_body">पिछले 20 sessions में रोज़ औसतन कितने रुपये का कारोबार हुआ — ज़्यादा turnover, आसान entry/exit।</string>
    <string name="help_part_momentum">Momentum • 10%</string>
    <string name="help_part_momentum_body">5 और 20 दिन का return। Trend पहले ही इसे गिनता है, इसलिए इसका वज़न कम है।</string>
    <string name="help_tiers_title">Tier</string>
    <string name="help_tiers_body">STRONG = %1$s+ (बाज़ार के लगभग top 7–8%%) • WATCH = %2$s+ • उसके नीचे WEAK।</string>
    <string name="help_rvol_title">RVOL</string>
    <string name="help_rvol_body">आज का volume ÷ पिछले 20 sessions का औसत। %1$s× या ज़्यादा पर card पर volume spike दिखता है।</string>
    <string name="help_plan_title">Trade plan</string>
    <string name="help_plan_body">Entry = 20 दिन का high + 0.1 ATR (breakout की पुष्टि)। Stop = 10 दिन का low, जिसे 1–2 ATR के बीच रखा जाता है। Targets = risk का 1.5, 2.5 और 4 गुना (1.5R / 2.5R / 4R)।</string>
    <string name="help_badges_title">Badges</string>
    <string name="item_sme_name">SME · %1$s</string>
    <string name="help_badges_body">NEW = पिछले स्कैन के बाद top list में नया • ▲ / ▼ = पिछले स्कैन से rank कितना ऊपर/नीचे • ★ = आपकी watchlist।</string>
    <string name="help_disclaimer">यह app सिर्फ़ जानकारी और सीखने के लिए है, निवेश सलाह नहीं। हर trade से पहले खुद research करें और risk संभालें।</string>

