        <item name="android:windowBackground">@drawable/bg_frost</item>
        <item name="scanCard">@color/frost_card</item>
        <item name="scanCardStroke">@color/frost_card_stroke</item>
        <item name="scanSheet">@color/frost_sheet</item>
        <item name="scanTrack">@color/frost_track</item>
        <item name="scanHeroBackground">@drawable/bg_hero_frost</item>
        <item name="scanLogoBackground">@drawable/bg_logo_frost</item>
    </style>

    <!--
        The system draws the launch window from the manifest theme before MainActivity can apply the
        picked one, so it gets a plain near-black that suits every theme instead of Galaxy's sky.
    -->
    <style name="Theme.ShareScan.Launch">
        <item name="android:windowBackground">@color/galaxy_bg</item>
    </style>

    <!--
        Lets the filter sheet draw behind the navigation bar instead of leaving a black strip under it.
        On Android 12+ the screen behind a sheet is frosted (blurred), so the sheets read as glass.
    -->
    <style name="ThemeOverlay.ShareScan.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowBlurBehindEnabled" tools:targetApi="31">true</item>
        <item name="android:windowBlurBehindRadius" tools:targetApi="31">24dp</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="bottomSheetStyle">@style/Widget.ShareScan.BottomSheet</item>
    </style>

    <!-- Dark glass sheet: see-through enough that the frosted, moving sky shows behind it. -->
    <style name="Widget.ShareScan.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/scanSheet</item>
    </style>

    <!-- Glass card: translucent fill with a soft glowing accent edge. -->
    <style name="ShareScanCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:stateListAnimator">@animator/press_scale_soft</item>
        <item name="cardBackgroundColor">?attr/scanCard</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/scanCardStroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!--
        Glass chip (toggle): a deep, see-through tinted glass pill. The body is chipSurfaceColor (smoked)
        under chipBackgroundColor (accent tint); the light on the glass (top rim, specular sheen, bottom
        glow) is the foreground glass_chip_shine, because Chip owns its background. The label and icons
        stay fully opaque.
        glass_chip_shine is inset 8dp top and bottom to sit exactly on the pill: that is the
        (chipMinTouchTargetSize - chipMinHeight) / 2 inset Chip adds, so keep those three values together.
        The side paddings keep every chip at least 48dp wide so Chip never insets the pill sideways.
    -->
    <style name="ShareScanChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/glass_chip_text</item>
        <item name="android:foreground">@drawable/glass_chip_shine</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ShareScan.GlassChip</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipSurfaceColor">@color/glass_chip_surface</item>
        <item name="chipBackgroundColor">@color/glass_chip_bg</item>
        <item name="chipStrokeColor">@color/glass_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="rippleColor">@color/glass_chip_ripple</item>
        <item name="checkedIconTint">@color/glass_chip_text</item>
        <item name="chipStartPadding">10dp</item>
        <item name="textStartPadding">8dp</item>
        <item name="textEndPadding">8dp</item>
        <item name="chipEndPadding">10dp</item>
    </style>

    <style name="ShareScanActionChip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/glass_chip_text</item>
        <item name="android:foreground">@drawable/glass_chip_shine</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ShareScan.GlassChip</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipSurfaceColor">@color/glass_chip_surface</item>
        <item name="chipBackgroundColor">@color/glass_chip_bg</item>
        <item name="chipStrokeColor">@color/glass_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="rippleColor">@color/glass_chip_ripple</item>
        <item name="chipIconTint">@color/glass_chip_icon</item>
        <item name="chipStartPadding">10dp</item>
        <item name="textStartPadding">8dp</item>
        <item name="textEndPadding">8dp</item>
        <item name="chipEndPadding">12dp</item>
    </style>

    <!-- Glass chips are full pills at any height (large font sizes too), matching their foreground shine. -->
    <style name="ShapeAppearance.ShareScan.GlassChip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!--
        Glass switch: a deep see-through glass tube (the accent glows through it when on) with a glass-bead thumb.
        The drawables carry their own colours and rim, so every Material tint and the outline decoration are cleared.
    -->
    <style name="Widget.ShareScan.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:thumb">@drawable/switch_glass_thumb</item>
        <item name="thumbTint">@null</item>
        <item name="track">@drawable/switch_glass_track</item>
        <item name="trackTint">@null</item>
        <item name="trackDecoration">@null</item>
        <item name="trackDecorationTint">@null</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="Widget.ShareScan.Button" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="Widget.ShareScan.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="Widget.ShareScan.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="Widget.ShareScan.ImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- "पक्का?" dialogs: their buttons dip like every other button. -->
    <style name="ThemeOverlay.ShareScan.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ShareScan.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ShareScan.DialogButton</item>
    </style>

    <style name="Widget.ShareScan.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <style name="StatValue">
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StatLabel">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Pill">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Menu sheets (MenuSheets.kt): title block under the drag handle. -->
    <style name="SheetTitle">
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SheetSubtitle">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsSection">
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A whole settings row is tappable and flips its switch. -->
    <style name="SettingsRow">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:stateListAnimator">@animator/press_scale_soft</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsRowBody">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:stateListAnimator">@animator/press_scale_soft</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="iconPadding">14dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.None</item>
    </style>
</resources>
