<resources>
    <string name="detail_section_products">क्या बनाती है</string>
    <string name="detail_products_hint">किसी product पर दबाएँ: उसे बनाने वाली companies list में दिखेंगी</string>
    <string name="product_chip_description">%1$s बनाने वाली companies दिखाएँ</string>
    <string name="product_applied">%1$s बनाने वाली companies</string>
    <string name="product_filter_leave">Product filter हटाएँ</string>
    <string name="product_empty_title">इस product की कोई company नहीं</string>
    <string name="product_empty_body">Filters के अंदर %1$s बनाने वाली कोई company इस स्कैन में नहीं मिली। ऊपर ✕ दबाकर product filter हटाएँ। Products का data हर रात R/S के साथ थोड़ा-थोड़ा भरता है।</string>
    <string name="settings_product_icons">Cards पर products के icon</string>
    <string name="help_products_title">🛞 क्या बनाती है (products)</string>
    <string name="help_products_body">Stock के detail में "क्या बनाती है" के नीचे company के products उनके icon के साथ दिखते हैं — जैसे 🛞 टायर, 🚗 कार, 💊 दवाइयाँ। ये Screener पर company के About और Key Points से हर रात R/S के साथ पढ़े जाते हैं (जो सिर्फ़ ग्राहकों के नाम हों, जैसे "cars के लिए tyres" में cars, वो नहीं गिने जाते)। किसी product पर दबाने से list में उसे बनाने वाली सारी companies दिखती हैं (filters के अंदर, Top limit से आगे भी); ऊपर के ✕ या Back से सब वापस। Menu → Settings → "Cards पर products के icon" से हर card पर नाम के आगे मुख्य 3 products के icon दिखते हैं। नया data कुछ दिनों में सभी stocks के लिए भरेगा।</string>
    <string name="settings_product_icons_hint">Company के नाम के आगे उसके मुख्य products के icon, जैसे 🛞 🚗</string>

