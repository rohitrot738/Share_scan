    <string name="text_title">மொழி, எழுத்துரு</string>
    <string name="text_subtitle">முழு ஆப்பும் எந்த மொழியில், எந்த எழுத்துருவில் தெரிய வேண்டும்</string>
    <string name="text_language">மொழி</string>
    <string name="text_language_note">மொழிபெயர்ப்பு ஆப்பிலேயே உருவானது, எந்தச் சொல்லிலாவது தவறு கண்டால் சொல்லுங்கள். பங்கு, நிறுவனப் பெயர்கள், செய்திகள், \"புதியது என்ன\" அப்படியே இருக்கும்.</string>
