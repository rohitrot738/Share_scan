    <string name="status_ready_title">ஸ்கேனுக்குத் தயார்</string>
    <string name="status_ready_body">அமைப்புகளில் தேர்ந்தெடுத்த பரிமாற்றங்களின் (NSE, SME, BSE) ஒவ்வொரு பங்கையும் பிரேக்அவுட் அமைப்பு, ட்ரெண்ட், வால்யூம், மொமென்டம், லிக்விடிட்டி அடிப்படையில் வரிசைப்படுத்தி, சிறந்த வேட்பாளர்களைத் தேர்ந்தெடுக்கிறது.</string>
    <string name="status_loading_title">பங்கு பட்டியல்கள் வருகின்றன…</string>
    <string name="status_loading_body">பங்கு பட்டியல்கள் பதிவிறங்குகின்றன • %1$s</string>
